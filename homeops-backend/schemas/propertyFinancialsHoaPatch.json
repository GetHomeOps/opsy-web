{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "notApplicable": { "type": "boolean" },
    "associationName": {
      "anyOf": [{ "type": "null" }, { "type": "string", "maxLength": 255 }]
    },
    "amount": {
      "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }]
    },
    "frequency": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "enum": ["monthly", "quarterly", "annually"] }
      ]
    },
    "nextDueDate": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "format": "date" }
      ]
    },
    "specialAssessment": {
      "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }]
    },
    "sourceDocumentId": {
      "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
    }
  }
}
