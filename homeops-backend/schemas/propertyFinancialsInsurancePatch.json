{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider": {
      "anyOf": [{ "type": "null" }, { "type": "string", "maxLength": 255 }]
    },
    "annualPremium": {
      "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }]
    },
    "renewalDate": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "format": "date" }
      ]
    },
    "policyNumber": {
      "anyOf": [{ "type": "null" }, { "type": "string", "maxLength": 120 }]
    },
    "deductible": {
      "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }]
    },
    "escrowIncluded": {
      "anyOf": [{ "type": "null" }, { "type": "boolean" }]
    },
    "sourceDocumentId": {
      "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
    }
  }
}
