{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "currentBalance": {
      "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }]
    },
    "monthlyPayment": {
      "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }]
    },
    "paymentDueDay": {
      "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1, "maximum": 31 }]
    },
    "interestRate": {
      "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0, "maximum": 100 }]
    },
    "escrowIncluded": {
      "anyOf": [{ "type": "null" }, { "type": "boolean" }]
    },
    "sourceDocumentId": {
      "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
    }
  }
}
